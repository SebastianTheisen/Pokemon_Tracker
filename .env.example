# Kopieren nach .env und Werte anpassen. .env niemals committen.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=tracker

PT_ENVIRONMENT=development
PT_LOG_LEVEL=INFO
PT_LOG_JSON=false
# Mit z. B. `openssl rand -hex 32` erzeugen
PT_JWT_SECRET=bitte-aendern
PT_CORS_ORIGINS=[]
# Zusätzliche Preisquellen als Plug-ins (Importpfade, siehe Plan 5.3), Standard: keine
PT_EXTRA_PRICE_PROVIDERS=[]

# Preise (Phase 2)
# Tägliche Preisrunde (Ortszeit); TCGdex aktualisiert vormittags (UTC)
PT_PRICE_REFRESH_TIME=12:30
PT_TIMEZONE=Europe/Berlin
# Beim Ansehen neu holen, wenn älter als … Stunden
PT_PRICE_MAX_AGE_HOURS=12
