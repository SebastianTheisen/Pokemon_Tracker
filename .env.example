# Kopieren nach .env und Werte anpassen. .env niemals committen.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=tracker

PT_ENVIRONMENT=development
PT_LOG_LEVEL=INFO
PT_LOG_JSON=false
# Mit z. B. `openssl rand -hex 32` erzeugen
PT_JWT_SECRET=bitte-aendern
PT_CORS_ORIGINS=[]
# Optionaler Cardmarket-Angebots-Provider (siehe Plan 5.3)
PT_CARDMARKET_LISTING_ENABLED=false
