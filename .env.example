# Kopieren nach .env und Werte anpassen. .env niemals committen.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=tracker

PT_ENVIRONMENT=development
PT_LOG_LEVEL=INFO
PT_LOG_JSON=false
# Mit z. B. `openssl rand -hex 32` erzeugen
PT_JWT_SECRET=bitte-aendern
PT_CORS_ORIGINS=[]
# Zusätzliche Preisquellen als Plug-ins (Importpfade, siehe Plan 5.3), Standard: keine
PT_EXTRA_PRICE_PROVIDERS=[]

# Preise (Phase 2)
# Tägliche Preisrunde (Ortszeit); TCGdex aktualisiert vormittags (UTC)
PT_PRICE_REFRESH_TIME=12:30
PT_TIMEZONE=Europe/Berlin
# Beim Ansehen neu holen, wenn älter als … Stunden
PT_PRICE_MAX_AGE_HOURS=12

# Scanner (Phase 4)
# Bilder pro Nutzer und Stunde, maximale Dateigröße (MB), Bilder pro Stapel
PT_SCAN_RATE_LIMIT_PER_HOUR=600
PT_SCAN_MAX_UPLOAD_MB=15
PT_SCAN_BATCH_MAX=20
# Scan-Protokoll (ohne Bilder) so viele Tage aufbewahren
PT_SCAN_LOG_RETENTION_DAYS=90
# Gleichzeitige OCR/Bildabgleich-Arbeiten (CPU)
PT_SCANNER_CONCURRENCY=1

# Tailscale (Phase 5): optionaler Auth-Key für das Gerät „kartenkiste“.
# Leer lassen = beim ersten Start Login-Link im Log (bash deploy/phase5_tailscale.sh)
TS_AUTHKEY=
